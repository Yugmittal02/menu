# ====================================
# SewaShubham Bakery - Production Environment
# ====================================
# Copy this file to .env and fill in your values
# For Digital Ocean deployment, set these in the server

# ------------------------------------
# Server Configuration
# ------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------
# Get connection string from MongoDB Atlas:
# Clusters -> Connect -> Drivers -> Copy connection string
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/sewashubham?retryWrites=true&w=majority

# ------------------------------------
# Authentication
# ------------------------------------
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=your_64_character_random_string_here

# ------------------------------------
# CORS - Allowed Origins (comma-separated)
# ------------------------------------
# Your frontend URL(s) - no trailing slash
ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# ------------------------------------
# Cloudinary (Image Uploads)
# ------------------------------------
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------
# Cashfree Easy Split (Multi-Tenant Marketplace Payments)
# ------------------------------------
# Get credentials from Cashfree Merchant Dashboard: https://merchant.cashfree.com
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# Environment: SANDBOX or PRODUCTION
CASHFREE_ENVIRONMENT=SANDBOX
# API Version: 2023-08-01 (default)
CASHFREE_API_VERSION=2023-08-01
# Cashfree Webhook secret for HMAC-SHA256 signature verification
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
# Platform commission in basis points (e.g., 0 for 0%, 200 for 2%)
PLATFORM_COMMISSION_BPS=0
# Optional mock mode for testing without Cashfree sandbox account (true/false)
CASHFREE_MOCK_MODE=false


